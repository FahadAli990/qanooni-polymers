PORT=5000
NODE_ENV=development

AUTH_USERNAME=asdf123
AUTH_PASSWORD=asdf123
JWT_SECRET=qanooni-polymers-dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# Prefer discrete vars locally; MYSQL_URL / DATABASE_URL also supported (Railway).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=Qanooni_db
MYSQL_SSL=false

# Comma-separated allowed browser origins
CLIENT_ORIGIN=http://localhost:5173
